CONFIG_ESP_MAIN_TASK_STACK_SIZE=40960
CONFIG_ESP_TASK_WDT_TIMEOUT_S=20
# A single WireSlot commit (components/pixels_mqtt_credentials) is a
# ~2.7 KiB NVS blob, spanning multiple flash pages; writing one disables
# interrupts/caches on both cores (spi_flash_disable_interrupts_caches_
# and_other_cpu) for the duration. Under QEMU's flash emulation timing
# that write alone can exceed the 300 ms default interrupt-watchdog
# timeout on CPU1, panicking with no logic fault involved. Raised well
# above any observed real write latency.
CONFIG_ESP_INT_WDT_TIMEOUT_MS=5000
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../partitions_network.csv"
